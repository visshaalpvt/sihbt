# Copy this file to .env and fill in real values. Never commit .env to git.

# Get this from @BotFather on Telegram (see notifier.py for steps)
TELEGRAM_BOT_TOKEN=

# How often to check the SIH portal, in seconds. 300 = 5 minutes.
# Don't go too low (e.g. under 60s) until we know the portal's rate limits.
POLL_INTERVAL_SECONDS=300
